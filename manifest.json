{
  "manifest_version": 3,
  "name": "Barq Minutes",
  "short_name": "Barq Minutes",
  "version": "0.1.0",
  "description": "Local-only meeting notes, transcription, summary, decisions, action items, open questions, and meeting Q&A. No backend. No telemetry.",
  "minimum_chrome_version": "121",
  "action": {
    "default_title": "Open Barq Minutes",
    "default_popup": "src/popup/popup.html"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "offscreen"
  ],
  "optional_permissions": [
    "tabCapture",
    "activeTab"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "src/offscreen/offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
