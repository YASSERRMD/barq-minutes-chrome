{
  "name": "barq-minutes-chrome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Barq Minutes for Chrome. Local-only meeting transcription, summary, decisions, action items, and Q&A. No backend, no telemetry, no cloud inference.",
  "license": "Apache-2.0",
  "author": "YASSERRMD <arafath.yasser@gmail.com>",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "barq-vweb": "^0.1.0",
    "barq-wasm": "^0.1.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.1",
    "jspdf": "^2.5.2",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.14.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
